{"uid":"experiments/statistics/rigorous_experiment.py","name":"rigorous_experiment.py","qualname":"experiments/statistics/rigorous_experiment.py","kind":"module","file":"experiments/statistics/rigorous_experiment.py","line":1,"end_line":720,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Rigorous Statistical Validation of Algorithmic Invariance","description":"Addressing reviewer concerns:\n1. Sample size: n≥5 seeds × 3 runs = 15 observations per cell\n2. Full ANOVA with SS, df, MS, F, p\n3. Pre-registered hypotheses\n4. Complete hyperparameter reporting\n5. Proper benchmarking with outlier elimination\n\nAuthor: Matrix Agent","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["experiments/statistics/rigorous_experiment.py::PRE_REGISTERED_HYPOTHESES","experiments/statistics/rigorous_experiment.py::ExperimentConfig","experiments/statistics/rigorous_experiment.py::ExperimentResult","experiments/statistics/rigorous_experiment.py::StrassenModel","experiments/statistics/rigorous_experiment.py::generate_data","experiments/statistics/rigorous_experiment.py::compute_discretization_error","experiments/statistics/rigorous_experiment.py::compute_spectral_gap","experiments/statistics/rigorous_experiment.py::run_single_experiment","experiments/statistics/rigorous_experiment.py::run_full_experiment","experiments/statistics/rigorous_experiment.py::perform_anova","experiments/statistics/rigorous_experiment.py::print_anova_table","experiments/statistics/rigorous_experiment.py::fit_noise_model","experiments/statistics/rigorous_experiment.py::find_optimal_B","experiments/statistics/rigorous_experiment.py::generate_report"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
{"uid":"experiments/statistics/rigorous_experiment.py::PRE_REGISTERED_HYPOTHESES","name":"PRE_REGISTERED_HYPOTHESES","qualname":"PRE_REGISTERED_HYPOTHESES","kind":"constant","file":"experiments/statistics/rigorous_experiment.py","line":31,"end_line":54,"language":"py","signature":"PRE_REGISTERED_HYPOTHESES","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"","description":"","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"experiments/statistics/rigorous_experiment.py","members":[],"inferred_raises":[],"returns_value":null,"value":"'\\n===============================================================================\\nPRE-REGISTERED EXPERIMENTAL HYPOTHESES\\nRegistered: 2026-01-16 01:45:00 UTC (before data collection)\\n===============================================================================\\n\\nH1 (Primary): Batch size B affects convergence to algorithmic invariance.\\n    - Alternative: η² > 0.14 (large effect) for B on discretization error\\n    - Null: η² ≤ 0.01 (negligible effect)\\n    \\nH2 (Secondary): Hardware noise ε_hw(B) follows non-monotonic function.\\n    - Alternative: Var_total(B) = α/B + β·cache_miss(B) + γ, with β > 0\\n    - Null: Var_total(B) = α/B + γ (pure statistical noise)\\n    \\nH3 (Exploratory): Optimal B* minimizes Var_total.\\n    - Prediction: B* ∈ [32, 128] based on cache line theory\\n    \\nREJECTION CRITERIA:\\n    - H1: Reject null if F > F_crit(α=0.05, df1, df2) in ANOVA\\n    - H2: Reject null if AIC(full model) < AIC(reduced model) - 2\\n    - H3: Report empirical B* with 95% CI via bootstrap\\n\\n===============================================================================\\n'","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
