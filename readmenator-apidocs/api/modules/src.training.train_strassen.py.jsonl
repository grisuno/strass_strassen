{"uid":"src/training/train_strassen.py::get_canonical_strassen","name":"get_canonical_strassen","qualname":"get_canonical_strassen","kind":"function","file":"src/training/train_strassen.py","line":211,"end_line":257,"language":"py","signature":"def get_canonical_strassen()","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Returns the canonical Strassen coefficients.","description":"Exact discrete coefficients for rank-7 tensor decomposition.\n\nStrassen's 7 products:\nM1 = (a11 + a22)(b11 + b22)\nM2 = (a21 + a22) * b11\nM3 = a11 * (b12 - b22)\nM4 = a22 * (b21 - b11)\nM5 = (a11 + a12) * b22\nM6 = (a21 - a11)(b11 + b12)\nM7 = (a12 - a22)(b21 + b22)\n\nResult reconstruction:\nc11 = M1 + M4 - M5 + M7\nc12 = M3 + M5\nc21 = M2 + M4\nc22 = M1 - M2 + M3 + M6","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"src/training/train_strassen.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":["src/training/train_strassen.py::main"]}
